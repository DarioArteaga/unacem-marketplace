# Local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/salto
# Railway: en el servicio de la API, Variables → Add Variable Reference →
# elige el servicio Postgres → DATABASE_URL (NO dejes el valor localhost).
# La app acepta también postgres:// y postgresql:// y los convierte a +psycopg.

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=10080
ANTHROPIC_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_NOMBRE=Super Admin
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-revalidate
LOG_LEVEL=INFO
