# Monorepo root — reglas compartidas. Ver también frontend/.gitignore y backend/.gitignore.

# misc
.DS_Store
*.pem

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# python (venv puede crearse en la raíz o en backend/)
.venv/
__pycache__/
*.pyc
